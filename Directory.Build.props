<Project>

  <!-- One version for every component, bumped on every push and tagged vX.Y.Z (ADR-0004). -->
  <PropertyGroup>
    <VersionPrefix>0.23.0</VersionPrefix>
    <Product>FBCTools</Product>
    <!-- The same holder as LICENSE (ADR-0013); shown in the files' version info. -->
    <Copyright>Copyright (c) 2026 Fatih Bahceci</Copyright>
    <!-- The public repository (ADR-0022); the setup links to it. -->
    <PackageProjectUrl>https://github.com/fatihbahceci/FBC.ShellExtension</PackageProjectUrl>
    <!-- A package with a known high or critical vulnerability stops the build (ADR-0045). The
         NativeAOT compiler and the runtime the programs carry come from the SDK, not from a
         reference here: the fix is a newer SDK. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>
