<Project Sdk="Microsoft.NET.Sdk">

  <!-- Restarts Explorer through Restart Manager and reopens its windows (ADR-0008). A console
       program, called by dev-run, the editor or a setup. NativeAOT like the runner, so it is a
       single file with no runtime to install. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FBC.ShellExtension.Core\FBC.ShellExtension.Core.csproj" />
  </ItemGroup>

</Project>
