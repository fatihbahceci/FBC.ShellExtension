<Project Sdk="Microsoft.NET.Sdk">

  <!-- Started by the shell extension for every click; NativeAOT for a fast start (ADR-0001).
       Raw Win32 window, and an elevated copy of itself for runas commands (ADR-0006). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FBC.ShellExtension.Core\FBC.ShellExtension.Core.csproj" />
    <ProjectReference Include="..\FBC.ShellExtension.WikiImport\FBC.ShellExtension.WikiImport.csproj" />
  </ItemGroup>

</Project>
